{
  "expo": {
    "name": "Audiation",
    "slug": "Audiation",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./store/play-icon-512.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.audiation",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.audiation",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./store/play-icon-512.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./store/play-icon-512.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161411",
          "image": "./store/play-icon-512.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Audiation uses the microphone to hear the tone you sing or play.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ],
      "expo-asset",
      "./plugins/withPlayNativeLibs.js",
      "./plugins/withVarispeed.js"
    ],
    "extra": {
      "eas": {
        "projectId": "1700d81d-b99f-4c36-9b26-42b686b98a2e"
      }
    },
    "owner": "startrooper"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-4322902709993646~4784385324",
    "ios_app_id": "ca-app-pub-4322902709993646~6354340063",
    "delay_app_measurement_init": true
  }
}
